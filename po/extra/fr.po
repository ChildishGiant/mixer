#: data/mixer.desktop.in:4 data/mixer.appdata.xml.in:9
msgid "Mixer"
msgstr "Mixeur"

#: data/mixer.desktop.in:5 data/mixer.appdata.xml.in:10
msgid "Change the volume of apps"
msgstr "Modifier le volume des applications"

#: data/mixer.desktop.in:6
msgid "Volume mixer"
msgstr "Mixeur de volume"

#: data/mixer.desktop.in:11
msgid "Sound;Audio"
msgstr "Sound;Audio;son;mixeur;volume;"

#: data/mixer.appdata.xml.in:12
msgid "A no-frills volume mixer, with simplicity and usability at its core."
msgstr ""
"Un mélangeur de volume sans fioritures, avec la simplicité et la facilité "
"d'utilisation au cœur."

#: data/mixer.appdata.xml.in:14
msgid "Simple volume controls including balance and output selection"
msgstr ""
"Des commandes de volume simples, y compris la sélection de la balance et de "
"la sortie"

#: data/mixer.appdata.xml.in:15
msgid "Individually change each audio source's values"
msgstr "Changez individuellement les valeurs de chaque source audio"

#: data/mixer.appdata.xml.in:21
msgid "Allie Law"
msgstr "Allie Law"

#: data/mixer.appdata.xml.in:34
msgid "Nothing new!"
msgstr "Rien de nouveau !"

#: data/mixer.appdata.xml.in:36
msgid ""
"Mixer has had a complete rewrite, allowing for wider compatability and "
"better stability (Fingers crossed!)"
msgstr ""
"Mixeur a été complètement réécrit, permettant une compatibilité plus large "
"et une meilleure stabilité (🤞️)"

#: data/mixer.appdata.xml.in:37
msgid ""
"There's now a suggested price of $3. As with all apps on AppCenter this is "
"split between elementary and me 30/70"
msgstr ""
"Il y a maintenant un prix suggéré de 3 $. Comme pour toutes les applications "
"sur AppCenter, il est partagé entre elementary et moi 30/70."

#: data/mixer.appdata.xml.in:43
msgid "Features:"
msgstr "Fonctionnalités :"

#: data/mixer.appdata.xml.in:45
msgid "Spanish translation"
msgstr "Traductions espagnole"

#: data/mixer.appdata.xml.in:46
msgid "Ruissian translation"
msgstr "Traduction russe"

#: data/mixer.appdata.xml.in:47
msgid "Also grey out the slider label if not in use"
msgstr ""
"L’étiquette du curseur est également grisée si elle n'est pas utilisée."

#: data/mixer.appdata.xml.in:48
msgid "Handle long apps more gracefully"
msgstr "Applications longues gérées avec plus d'élégance"

#: data/mixer.appdata.xml.in:49
msgid "Scroll window if not all apps fit"
msgstr "Faire défiler la fenêtre si toutes les applications ne s'adaptent pas"

#: data/mixer.appdata.xml.in:51
msgid "Bug fixes:"
msgstr "Corrections de bogues"

#: data/mixer.appdata.xml.in:53
msgid "Fix for running on German systems"
msgstr "Correction pour l’exécution sur des systèmes allemands"

#: data/mixer.appdata.xml.in:54
msgid "Fix for app names with non-alpha characters not capturing"
msgstr ""
"Correction pour les noms d’applications avec des caractères non-alphabétiques"

#: data/mixer.appdata.xml.in:60
msgid "Updated AppCenter metadata"
msgstr "Métadonnées de l’AppCenter mises à jour"

#: data/mixer.appdata.xml.in:65 data/mixer.appdata.xml.in:74
msgid "Added features:"
msgstr "Fonctionnalités ajoutées :"

#: data/mixer.appdata.xml.in:67
msgid "Added support for Odin's dark style"
msgstr "Ajout du support pour le style sombre Odin"

#: data/mixer.appdata.xml.in:68
msgid "Changed some backend things to be more in-line with stock apps"
msgstr ""
"Modification de certains éléments du backend pour qu'ils soient plus "
"conformes aux applications de base."

#: data/mixer.appdata.xml.in:76
msgid "Added a dropdown for changing which output an app uses"
msgstr ""
"Ajout d'un menu déroulant pour changer la sortie utilisée par une application"

#: data/mixer.appdata.xml.in:82
msgid "Initial Release"
msgstr "Version initiale"

#~ msgid "com.github.childishgiant.mixer"
#~ msgstr "com.github.childishgiant.mixer"
